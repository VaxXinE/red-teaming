#!/usr/bin/env python3
import os, sys
from pathlib import Path
if len(sys.argv) != 2:
    print(f"usage: {sys.argv[0]} FILE", file=sys.stderr); raise SystemExit(2)
src=Path(sys.argv[1])
try:
    data=src.read_bytes()
except Exception as exc:
    print(f"read failed: {exc}", file=sys.stderr); raise SystemExit(1)
out=Path('/tmp/backup-output')
out.write_bytes(data)
os.chmod(out, 0o644)
print(f"copied {src} -> {out}")
